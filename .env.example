# Copy to .env (gitignored) and fill in.
#
# VALUES MUST BE QUOTED. DATABASE_URL contains an `&`, and unquoted, a shell
# `source` backgrounds the assignment and silently loses the variable.

# Fine-grained GitHub PAT. Public repositories, read-only. No account
# permissions needed. An expiring token silently kills collection and the gap
# in history cannot be backfilled, so either set no expiry or calendar a
# reminder a week before it lapses.
GH_TOKEN="github_pat_..."

# Neon connection string. Keep ?sslmode=require - Neon rejects unencrypted
# connections. This is the production database; the collector writes here.
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# dbt-postgres cannot take a connection URL, only components. These are the
# same credentials as DATABASE_URL above, split out for the `prod` and `ci`
# targets in dbt_project/profiles.yml. Keep them in sync with it.
#
# CI does not need these as separate secrets - the workflow derives them from
# DATABASE_URL at runtime.
NEON_HOST="ep-xxx.region.aws.neon.tech"
NEON_PORT="5432"
NEON_USER="user"
NEON_PASSWORD="pass"
NEON_DB="neondb"

# Host port for the local dev Postgres. docker-compose publishes on it and
# dbt's dev target reads it, so changing it here is enough. 5433 rather than
# 5432 so a native Postgres install does not collide.
RADAR_PG_PORT="5433"
